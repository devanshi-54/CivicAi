<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fragment_gov_complaint_details_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_light">

    <!-- Navigation Header -->
    <LinearLayout
        android:id="@+id/gov_details_nav_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/card_surface"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="12dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details_back"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Back"
            android:textSize="12sp"
            android:textColor="@color/primary_text"
            app:icon="@drawable/ic_arrow_back"
            app:iconSize="16dp"
            app:iconTint="@color/primary_text"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Complaint Details"
            android:textColor="@color/primary_text"
            android:textSize="15sp"
            android:textStyle="bold"
            android:singleLine="true"
            android:ellipsize="end"
            android:paddingStart="6dp"
            android:paddingEnd="6dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_details_home"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Home"
            android:textSize="12sp"
            android:textColor="@color/primary_text"
            app:icon="@drawable/ic_home"
            app:iconSize="16dp"
            app:iconTint="@color/primary_text"
            android:paddingStart="8dp"
            android:paddingEnd="12dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/border_color" />

    <ScrollView
        android:id="@+id/gov_details_scroll_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Loading state -->
        <ProgressBar
            android:id="@+id/details_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="48dp"
            android:visibility="gone" />

        <!-- Error state -->
        <TextView
            android:id="@+id/details_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Complaint not found."
            android:textColor="@color/high_priority"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="24dp"
            android:visibility="gone" />

        <!-- Main content container -->
        <LinearLayout
            android:id="@+id/details_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- ── Complaint Info Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_complaint_info"
                style="@style/CivicAi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Section Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="18dp"
                            android:layout_height="18dp"
                            android:src="@drawable/ic_report"
                            android:contentDescription="Complaint info"
                            app:tint="@color/primary_blue" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Complaint Information"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />
                        <TextView
                            android:id="@+id/detail_status_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Submitted"
                            android:textSize="11sp"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@drawable/bg_badge_ai" />
                    </LinearLayout>

                    <!-- Priority row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="10dp">
                        <TextView
                            android:id="@+id/detail_priority_badge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="HIGH PRIORITY"
                            android:textSize="11sp"
                            android:textStyle="bold"
                            android:paddingStart="10dp"
                            android:paddingEnd="10dp"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:background="@drawable/bg_badge_high_priority" />
                        <TextView
                            android:id="@+id/detail_complaint_id"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="10dp"
                            android:text="#CMP-XXXX"
                            android:textColor="@color/secondary_text"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/detail_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Complaint Title"
                        android:textColor="@color/primary_text"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/detail_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textColor="@color/gray_700"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp"
                        android:lineSpacingMultiplier="1.4" />

                    <!-- Meta info grid -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="8dp">
                        <!-- Citizen column hidden for privacy: government users must not see citizen name.
                             The TextView ID is kept because Java code may still reference it. -->
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical" android:visibility="gone">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Citizen" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_citizen_name" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView android:layout_width="14dp" android:layout_height="14dp" android:src="@drawable/ic_map" android:contentDescription="Location" app:tint="@color/secondary_text" />
                        <TextView android:id="@+id/detail_location" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:text="—" android:textColor="@color/secondary_text" android:textSize="13sp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── AI Recommendation Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_ai_recommendation"
                style="@style/CivicAi.Card.Ai"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header with AI badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="4dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_ai_sparkle"
                            android:contentDescription="AI"
                            app:tint="@color/ai_accent" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="AI Recommendation"
                            android:textColor="@color/ai_accent"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Advisory Only"
                            android:textColor="@color/ai_accent"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_badge_ai" />
                    </LinearLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="AI analysis is advisory and does not replace official government decisions."
                        android:textColor="@color/ai_accent"
                        android:textSize="11sp"
                        android:textStyle="italic"
                        android:layout_marginBottom="12dp"
                        android:alpha="0.7" />

                    <!-- AI Summary -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Summary" android:textColor="@color/secondary_text" android:textSize="11sp" android:textStyle="bold" />
                    <TextView android:id="@+id/detail_ai_summary" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:layout_marginBottom="10dp" android:lineSpacingMultiplier="1.3" />

                    <!-- AI meta grid -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Category" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_ai_category" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Priority" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_ai_priority" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/ai_accent" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Severity" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_ai_severity" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Urgency" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_ai_urgency" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Safety Risk" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_ai_safety_risk" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Affected People" android:textColor="@color/secondary_text" android:textSize="11sp" />
                            <TextView android:id="@+id/detail_ai_affected" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suggested Department" android:textColor="@color/secondary_text" android:textSize="11sp" />
                    <TextView android:id="@+id/detail_ai_dept" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Suggested Action" android:textColor="@color/secondary_text" android:textSize="11sp" />
                    <TextView android:id="@+id/detail_ai_action" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:layout_marginBottom="8dp" />

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Reasoning" android:textColor="@color/secondary_text" android:textSize="11sp" />
                    <TextView android:id="@+id/detail_ai_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/gray_700" android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="8dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Confidence:" android:textColor="@color/secondary_text" android:textSize="12sp" android:layout_marginEnd="8dp" />
                        <ProgressBar
                            android:id="@+id/detail_ai_confidence_bar"
                            style="@android:style/Widget.ProgressBar.Horizontal"
                            android:layout_width="0dp"
                            android:layout_height="8dp"
                            android:layout_weight="1"
                            android:max="100"
                            android:progress="0"
                            android:progressTint="@color/ai_accent"
                            android:progressBackgroundTint="@color/ai_accent_light" />
                        <TextView
                            android:id="@+id/detail_ai_confidence_text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="—%"
                            android:textColor="@color/ai_accent"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ── Official Government Decision Card ── -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/card_official_decision"
                style="@style/CivicAi.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:strokeColor="@color/primary_blue">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">
                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_verified_badge"
                            android:contentDescription="Official"
                            app:tint="@color/primary_blue" />
                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="8dp"
                            android:text="Official Government Decision"
                            android:textColor="@color/primary_blue"
                            android:textSize="13sp"
                            android:textStyle="bold"
                            android:letterSpacing="0.04" />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Authoritative"
                            android:textColor="@color/primary_blue"
                            android:textSize="10sp"
                            android:paddingStart="8dp"
                            android:paddingEnd="8dp"
                            android:paddingTop="3dp"
                            android:paddingBottom="3dp"
                            android:background="@drawable/bg_badge_ai" />
                    </LinearLayout>

                    <!-- No decision yet placeholder -->
                    <TextView
                        android:id="@+id/detail_no_decision"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No official decision recorded yet."
                        android:textColor="@color/secondary_text"
                        android:textSize="13sp"
                        android:gravity="center"
                        android:padding="16dp"
                        android:visibility="visible" />

                    <!-- Decision details (shown when decision exists) -->
                    <LinearLayout
                        android:id="@+id/detail_decision_content"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="8dp">
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Official Priority" android:textColor="@color/secondary_text" android:textSize="11sp" />
                                <TextView android:id="@+id/detail_official_priority" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                            </LinearLayout>
                            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
                                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assigned Department" android:textColor="@color/secondary_text" android:textSize="11sp" />
                                <TextView android:id="@+id/detail_assigned_dept" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:textStyle="bold" />
                            </LinearLayout>
                        </LinearLayout>

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Assigned Officer" android:textColor="@color/secondary_text" android:textSize="11sp" />
                        <TextView android:id="@+id/detail_assigned_officer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:layout_marginBottom="8dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Official Decision" android:textColor="@color/secondary_text" android:textSize="11sp" />
                        <TextView android:id="@+id/detail_official_decision_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/primary_text" android:textSize="13sp" android:lineSpacingMultiplier="1.4" android:layout_marginBottom="8dp" />

                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Internal Notes" android:textColor="@color/secondary_text" android:textSize="11sp" />
                        <TextView android:id="@+id/detail_internal_notes" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="—" android:textColor="@color/gray_700" android:textSize="13sp" android:lineSpacingMultiplier="1.4" />

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Open Decision Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_open_decision"
                style="@style/CivicAi.Button.Primary"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:text="Record / Update Official Decision"
                android:textSize="14sp"
                android:layout_marginBottom="24dp" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>

</LinearLayout>