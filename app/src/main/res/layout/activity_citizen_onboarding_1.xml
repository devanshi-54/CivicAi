<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/civic_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/btnSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:text="Skip"
        android:textColor="@color/civic_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/imgOnboarding"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:layout_marginTop="20dp"
        android:src="@drawable/illustration_onboarding_1" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:text="Report Civic Issues Easily"
        android:textColor="@color/civic_navy"
        android:textSize="24sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Tell CivicAI about problems in your area and submit a geotagged complaint in just a few clicks."
        android:textColor="@color/civic_text_secondary"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Indicator Dots (Page 1) -->
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center" android:layout_marginBottom="24dp" android:orientation="horizontal">
        <View android:layout_width="20dp" android:layout_height="6dp" android:background="@color/civic_primary" />
        <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="6dp" android:background="@color/civic_border" />
        <View android:layout_width="6dp" android:layout_height="6dp" android:layout_marginStart="6dp" android:background="@color/civic_border" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnNext"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/civic_primary"
        android:text="Next →" />
</LinearLayout>


